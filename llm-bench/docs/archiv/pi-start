#!/bin/bash
#
# pi-start - Pi Agent Starter mit allen Qwen-Modellen für 4GB VRAM
# Vereint: pi-engine.sh + pi-model.sh + start-pi.sh
#

set -e

# Farben
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
NC='\033[0m'

echo -e "${BLUE}╔════════════════════════════════════════════════════════╗${NC}"
echo -e "${BLUE}║${NC}           Pi Agent Start - Qwen Modelle            ${BLUE}║${NC}"
echo -e "${BLUE}╚════════════════════════════════════════════════════════╝${NC}"
echo

# Hardware Info
echo -e "${YELLOW}Deine Hardware:${NC}"
if command -v nvidia-smi &> /dev/null; then
    GPU_NAME=$(nvidia-smi --query-gpu=name --format=csv,noheader | head -1)
    VRAM_FREE=$(nvidia-smi --query-gpu=memory.free --format=csv,noheader,nounits | head -1)
    echo -e "  ${GREEN}GPU:${NC} $GPU_NAME (${VRAM_FREE} MB frei)"
fi
if command -v lscpu &> /dev/null; then
    CPU_NAME=$(lscpu | grep "Model name" | cut -d: -f2 | xargs)
    CPU_CORES=$(lscpu | grep "^CPU(s)" | cut -d: -f2 | xargs)
    echo -e "  ${GREEN}CPU:${NC} $CPU_NAME ($CPU_CORES Kerne)"
fi
echo

# Laufende Prozesse stoppen
echo -e "${YELLOW}Stoppe laufende Prozesse...${NC}"
pkill -9 -f koboldcpp 2>/dev/null || true
pkill -9 -f llmster 2>/dev/null || true
sleep 3
echo -e "${GREEN}✓ Bereit${NC}"
echo

# Engine + Modell Auswahl kombiniert
echo -e "${CYAN}═══════════════════════════════════════════════════════${NC}"
echo -e "${CYAN}  WÄHLE DEIN MODELL (Alle für 4GB VRAM optimiert)${NC}"
echo -e "${CYAN}═══════════════════════════════════════════════════════${NC}"
echo
echo -e "${MAGENTA}═══ ALLE QWEN MODELLE (KoboldCPP + CUDA) ═══${NC}"
echo -e "  ${GREEN}1)${NC} Qwen3.5-2B (1.2GB) 🏆 - BESTES 2B MODELL (neu!)"
echo -e "  ${GREEN}2)${NC} Qwen3.5-4B (2.6GB) 🔥 - Neueste 4B Version"
echo -e "  ${GREEN}3)${NC} Qwen3-4B (2.8GB) ⭐ - Bewährt (CUDA)"
echo -e "  ${GREEN}4)${NC} Qwen3-1.7B (1.2GB) ⚡ - Schnell"
echo -e "  ${GREEN}5)${NC} Qwen2.5-3B (1.8GB) - Gut"
echo -e "  ${GREEN}6)${NC} Qwen2.5-Coder-3B (1.8GB) 💻 - Code-spezialisiert"
echo -e "  ${GREEN}7)${NC} Qwen2.5-1.5B (941MB) 🚀 - Schnellste"
echo -e "  ${GREEN}8)${NC} Qwen2.5-Coder-1.5B (941MB) 💻 - Code Mini"
echo
echo -e "${MAGENTA}═══ LM STUDIO ALTERNATIVE ═══${NC}"
echo -e "  ${GREEN}9)${NC} LM Studio + Qwen3-4B (Vulkan)"
echo
echo -e "  ${GREEN}10)${NC} ${RED}Abbrechen${NC}"
echo
read -p "  Auswahl [1-10]: " model_choice

# Modell-Konfiguration
case $model_choice in
    1)
        PROVIDER="koboldcpp"
        MODEL="Qwen3.5-2B"
        MODEL_NAME="Qwen3.5-2B"
        MODEL_PATH="/home/g/.lmstudio/models/Qwen3.5-2B/Qwen3.5-2B-Q4_K_M.gguf"
        PORT="5001"
        GPU_LAYERS="25"
        ;;
    2)
        PROVIDER="koboldcpp"
        MODEL="Qwen3.5-4B"
        MODEL_NAME="Qwen3.5-4B"
        MODEL_PATH="/home/g/.lmstudio/models/Qwen3.5-4B/Qwen3.5-4B-Q4_K_M.gguf"
        PORT="5001"
        GPU_LAYERS="30"
        ;;
    3)
        PROVIDER="koboldcpp"
        MODEL="qwen3-4b"
        MODEL_NAME="Qwen3-4B"
        MODEL_PATH="/home/g/.lmstudio/models/lmstudio-community/Qwen3-4B-GGUF/Qwen3-4B-Q4_K_M.gguf"
        PORT="5001"
        GPU_LAYERS="30"
        ;;
    4)
        PROVIDER="koboldcpp"
        MODEL="Qwen3-1.7B"
        MODEL_NAME="Qwen3-1.7B"
        MODEL_PATH="/home/g/.lmstudio/models/Qwen3-1.7B/Qwen3-1.7B-Q4_K_M.gguf"
        PORT="5001"
        GPU_LAYERS="20"
        ;;
    5)
        PROVIDER="koboldcpp"
        MODEL="Qwen2.5-3B"
        MODEL_NAME="Qwen2.5-3B"
        MODEL_PATH="/home/g/.lmstudio/models/Qwen2.5-3B-Instruct/Qwen2.5-3B-Instruct-Q4_K_M.gguf"
        PORT="5001"
        GPU_LAYERS="25"
        ;;
    6)
        PROVIDER="koboldcpp"
        MODEL="Qwen2.5-Coder-3B"
        MODEL_NAME="Qwen2.5-Coder-3B"
        MODEL_PATH="/home/g/.lmstudio/models/Qwen2.5-Coder-3B-Instruct/Qwen2.5-Coder-3B-Instruct-Q4_K_M.gguf"
        PORT="5001"
        GPU_LAYERS="25"
        ;;
    7)
        PROVIDER="koboldcpp"
        MODEL="Qwen2.5-1.5B"
        MODEL_NAME="Qwen2.5-1.5B"
        MODEL_PATH="/home/g/.lmstudio/models/Qwen2.5-1.5B-Instruct/Qwen2.5-1.5B-Instruct-Q4_K_M.gguf"
        PORT="5001"
        GPU_LAYERS="20"
        ;;
    8)
        PROVIDER="koboldcpp"
        MODEL="Qwen2.5-Coder-1.5B"
        MODEL_NAME="Qwen2.5-Coder-1.5B"
        MODEL_PATH="/home/g/.lmstudio/models/Qwen2.5-Coder-1.5B-Instruct/Qwen2.5-Coder-1.5B-Instruct-Q4_K_M.gguf"
        PORT="5001"
        GPU_LAYERS="20"
        ;;
    9)
        PROVIDER="lmstudio"
        MODEL="qwen/qwen3-4b"
        MODEL_NAME="Qwen3-4B (LM Studio)"
        MODEL_ID="qwen3-4b"
        PORT="1234"
        ;;
    10)
        echo -e "${YELLOW}Abgebrochen.${NC}"
        exit 0
        ;;
    *)
        echo -e "${RED}Ungültige Auswahl!${NC}"
        exit 1
        ;;
esac

echo

# Backend starten
echo -e "${YELLOW}Starte $MODEL_NAME...${NC}"

if [ "$PROVIDER" == "lmstudio" ]; then
    # LM Studio starten
    echo "  → LM Studio Daemon wird gestartet..."
    if command -v lms &> /dev/null; then
        lms daemon up 2>&1 | grep -v "^$" || true
        sleep 3

        echo "  → LM Studio Server wird gestartet (Port $PORT)..."
        lms server start -p $PORT 2>&1 || true
        sleep 2

        if curl -s http://localhost:$PORT > /dev/null 2>&1; then
            echo -e "${GREEN}  ✓ LM Studio Server läuft auf Port $PORT${NC}"
        else
            echo -e "${RED}  ⚠ LM Studio Server konnte nicht gestartet werden${NC}"
        fi

        echo "  → Modell wird geladen: $MODEL_ID..."
        lms load "$MODEL_ID" 2>&1 || true
        sleep 3
    else
        echo -e "${RED}  ⚠ lms Befehl nicht gefunden!${NC}"
        exit 1
    fi

elif [ "$PROVIDER" == "koboldcpp" ]; then
    # KoboldCPP starten
    KOBOldCPP_PATH="/home/g/.local/koboldcpp"

    if [ ! -f "$MODEL_PATH" ]; then
        echo -e "${RED}  ⚠ Modell nicht gefunden: $MODEL_PATH${NC}"
        exit 1
    fi

    if [ "$GPU_LAYERS" == "0" ]; then
        echo "  → KoboldCPP (CPU) wird gestartet (Port $PORT)..."
    else
        echo "  → KoboldCPP (CUDA, $GPU_LAYERS Layers) wird gestartet (Port $PORT)..."
    fi

    cd "$KOBOldCPP_PATH"

    if [ "$GPU_LAYERS" == "0" ]; then
        nohup ./koboldcpp-linux-x64 \
            "$MODEL_PATH" \
            --port $PORT \
            --threads 8 \
            --contextsize 8192 \
            --smartcontext \
            --foreground > /tmp/koboldcpp.log 2>&1 &
    else
        nohup ./koboldcpp-linux-x64 \
            "$MODEL_PATH" \
            --port $PORT \
            --threads 8 \
            --gpulayers $GPU_LAYERS \
            --contextsize 8192 \
            --usecuda 0 \
            --smartcontext \
            --foreground > /tmp/koboldcpp.log 2>&1 &
    fi

    KOBO_PID=$!
    echo "  → KoboldCPP PID: $KOBO_PID"

    echo "  → Warte auf Server-Start..."
    for i in {1..60}; do
        if curl -s http://localhost:$PORT/api/v1/model > /dev/null 2>&1; then
            echo -e "${GREEN}  ✓ KoboldCPP Server läuft auf Port $PORT${NC}"
            break
        fi
        echo -n "."
        sleep 1
    done
    echo
fi

echo
echo -e "${GREEN}╔════════════════════════════════════════════════════════╗${NC}"
echo -e "${GREEN}║${NC}  Backend gestartet! Pi Agent wird jetzt geöffnet...  ${GREEN}║${NC}"
echo -e "${GREEN}╚════════════════════════════════════════════════════════╝${NC}"
echo
echo -e "${BLUE}Provider:${NC} $PROVIDER"
echo -e "${BLUE}Modell:${NC} $MODEL_NAME"
echo -e "${BLUE}Befehl:${NC} pi --provider $PROVIDER --model $MODEL --tools bash"
echo
echo -e "${YELLOW}Drücke Strg+C um Pi Agent zu beenden${NC}"
echo

# Pi Agent starten
cd /home/g
pi --provider $PROVIDER --model $MODEL --tools bash
