+// zid: Die Hash-Map der Element-IDs liegt im persistenten Speicher und wurde nie geleert:
+// jede je gesehene ID belegt einen Eintrag, bis die Kapazität (maxElementCount) erreicht ist.
+// Danach liefert Clay__AddHashMapItem NULL, neue Elemente bekommen keinen Eintrag mehr —
+// Clay_GetElementData meldet sie als nicht gefunden, Hover und Klick darauf sind tot, ohne
+// Fehlermeldung. Eine Markdown-Vorschau ohne Zeilenumbruch (hunderte anonyme Textstücke je
+// Reihe, mit jedem Scrollen andere Kombinationen) füllte 16384 Einträge in Sekunden.
+// Verdichtet die Map, sobald sie zu drei Vierteln voll ist: behält, was in den letzten drei
+// Frames gezeichnet wurde, baut die Ketten neu auf. debugElementData wandert im Gleichschritt,
+// weil jeder Eintrag per Zeiger darauf zeigt.
+void Clay__CompactLayoutElementsHashMap(Clay_Context *context) {
+    Clay__LayoutElementHashMapItemArray *internal = &context->layoutElementsHashMapInternal;
+    if (internal->length < internal->capacity / 4 * 3) {
+        return;
+    }
+    int32_t write = 0;
+    for (int32_t read = 0; read < internal->length; read++) {
+        Clay_LayoutElementHashMapItem *item = &internal->internalArray[read];
+        if (context->generation - item->generation > 2) {
+            continue;
+        }
+        if (write != read) {
+            internal->internalArray[write] = *item;
+            context->debugElementData.internalArray[write] = *item->debugData;
+            internal->internalArray[write].debugData = &context->debugElementData.internalArray[write];
+        }
+        write++;
+    }
+    internal->length = write;
+    context->debugElementData.length = write;
+    for (int32_t i = 0; i < context->layoutElementsHashMap.capacity; ++i) {
+        context->layoutElementsHashMap.internalArray[i] = -1;
+    }
+    for (int32_t i = 0; i < write; i++) {
+        Clay_LayoutElementHashMapItem *item = &internal->internalArray[i];
+        uint32_t bucket = item->elementId.id % context->layoutElementsHashMap.capacity;
+        item->nextIndex = context->layoutElementsHashMap.internalArray[bucket];
+        context->layoutElementsHashMap.internalArray[bucket] = i;
+    }
+}
+
 CLAY_WASM_EXPORT("Clay_BeginLayout")
 void Clay_BeginLayout(void) {
     Clay_Context* context = Clay_GetCurrentContext();
     Clay__InitializeEphemeralMemory(context);
     context->generation++;
+    Clay__CompactLayoutElementsHashMap(context); // zid: siehe oben
     context->dynamicElementIndex = 0;
     // Set up the root container that covers the entire window
     Clay_Dimensions rootDimensions = {context->layoutDimensions.width, context->layoutDimensions.height};
